<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <AssemblyName>KochPrusaSlicer</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
    <OptionExplicit>On</OptionExplicit>
    <PlatformTarget>x64</PlatformTarget>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <Version>0.1.0</Version>
    <Product>KOCH Send to PrusaSlicer (KOCH Engineering)</Product>
    <AssemblyTitle>KOCH Send to PrusaSlicer</AssemblyTitle>
    <Authors>KOCH Engineering</Authors>
    <Company>KOCH Engineering</Company>
    <Copyright>(c) 2026 KOCH Engineering</Copyright>
    <Description>Sends Alibre Design parts to PrusaSlicer - loader.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlibreInstallRoot)' == ''">
    <AlibreInstallRoot Condition="'$(ProgramW6432)' != ''">$(ProgramW6432)</AlibreInstallRoot>
    <AlibreInstallRoot Condition="'$(ProgramW6432)' == ''">C:\Program Files</AlibreInstallRoot>
  </PropertyGroup>

  <Target Name="LocateAlibre" BeforeTargets="BeforeResolveReferences">
    <ItemGroup Condition="'$(AlibreProgramPath)' == ''">
      <_AlibreXCandidate Include="$(AlibreInstallRoot)\Alibre Design*\Program\AlibreX.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'$(AlibreProgramPath)' == ''">
      <_AlibreDetected>%(_AlibreXCandidate.RootDir)%(_AlibreXCandidate.Directory)</_AlibreDetected>
    </PropertyGroup>
    <PropertyGroup Condition="'$(AlibreProgramPath)' == ''">
      <AlibreProgramPath>$(_AlibreDetected)</AlibreProgramPath>
    </PropertyGroup>

    <Error Condition="'$(AlibreProgramPath)' == ''"
           Text="No Alibre Design installation was found under $(AlibreInstallRoot). Pass -p:AlibreProgramPath=&quot;&lt;install&gt;\Program\&quot; (trailing backslash required)." />
    <Error Condition="!Exists('$(AlibreProgramPath)AlibreAddOn.dll')"
           Text="AlibreAddOn.dll was not found in $(AlibreProgramPath)." />
    <Message Importance="high" Text="Building against $(AlibreProgramPath)" />

    <ItemGroup>
      <Reference Include="AlibreAddOn">
        <HintPath>$(AlibreProgramPath)AlibreAddOn.dll</HintPath>
        <Private>False</Private>
      </Reference>
      <Reference Include="AlibreX">
        <HintPath>$(AlibreProgramPath)AlibreX.dll</HintPath>
        <Private>False</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <!-- Only if the .NET Framework 4.8 developer pack is not installed -->
  <ItemGroup Condition="'$(KochLocalBuild)' != 'true' And !Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8')">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="SendToPrusaSlicer.ico" />
    <None Remove="KochPrusaSlicer.adc" />
    <Content Include="SendToPrusaSlicer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="KochPrusaSlicer.adc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
